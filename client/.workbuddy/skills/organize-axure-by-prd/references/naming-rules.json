    "F06": { "label": "功能简介", "suffix": "features" },
    "F07": { "label": "首次交易指引", "suffix": "tutorial" },
    "F08": { "label": "FAQ", "suffix": "faq" },
    "F09": { "label": "下载", "suffix": "download" },
    "F10": { "label": "Footer", "suffix": "footer" },
    "F11": { "label": "多语言与双端适配", "suffix": "multilingual" }
